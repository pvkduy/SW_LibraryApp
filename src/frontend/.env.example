# Copy this file to .env.local in THIS folder (src/frontend/) — then restart `npm run dev`.
#
#   cp .env.example .env.local        # macOS / Linux / Git Bash
#   copy .env.example .env.local      # Windows CMD
#
# The values below work as-is against the LOCAL Supabase stack
# (`npx supabase start --workdir src`). They are the standard dev keys shipped
# with the Supabase CLI: identical on every machine and safe to share, because
# they only work against http://127.0.0.1:54321 on your own computer.
#
# WARNING: do NOT paste keys from the Supabase Dashboard here. Dashboard keys
# belong to the hosted cloud project and will not work against the local URL.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Optional: enables the simulated-failure control on the payment page (R-11).
VITE_PAYMENT_SIMULATOR_CONTROLS=true

# Only the publishable (anon) key belongs in client code. The service_role /
# secret key must NEVER appear here — privileged writes go through Edge
# Functions (SRS NFR-06).
